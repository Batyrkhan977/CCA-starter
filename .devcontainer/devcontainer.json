{
  "name": "CCA AI Web Development",

  "image": "mcr.microsoft.com/devcontainers/universal:2",

  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "files.autoSave": "afterDelay"
      }
    }
  },

  "forwardPorts": [8000],

  "portsAttributes": {
    "8000": {
      "label": "My Website",
      "onAutoForward": "openPreview"
    }
  }
}
